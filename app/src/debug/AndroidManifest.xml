<?xml version="1.0" encoding="utf-8"?>
<!-- Builds debug uniquement : outils de vérification, absents de l'APK release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Simule une autorisation Google Drive expirée en mode démo (voir DebugAuthReceiver). -->
        <receiver
            android:name=".DebugAuthReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
